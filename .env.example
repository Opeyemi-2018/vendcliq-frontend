# ====================================
# API ENDPOINTS
# ====================================

# Main backend API base URL for VERA core services
VERA_API_BASE_URL=https://api.yourdomain.com

# Inventory management service API base URL
VERA_INVENTORY_API_BASE_URL=https://inventory.yourdomain.com/

# Logistics service API base URL for shipping and delivery operations
VENDCLIQ_LOGISTIC_API_BASE_URL=https://logistics.yourdomain.com/logistics-client

# ====================================
# API KEYS & AUTHENTICATION
# ====================================

# Product service API key for product-related operations
PRODUCT_API_KEY=your_product_api_key_here

# General API key for authenticating requests to backend services
API_KEY=your_general_api_key_here

# Application secret key for JWT signing and session encryption
# Used for secure authentication token generation
APP_SECRET_KEY=your_app_secret_key_here

# ====================================
# ENVIRONMENT & CLIENT CONFIGURATION
# ====================================

# Node environment: 'production' for live app, 'development' for local testing
# Affects error handling, logging, and feature flags
NODE_ENV=development

# OAuth/OpenID Connect client ID for identifying this web app to auth server
CLIENT_ID=your_oauth_client_id_here

# Client version for API versioning and feature compatibility checks
CLIENT_VERSION=1.0.0

# Production frontend application origin (for CORS and redirects)
CLIENT_ORIGIN=https://app.yourdomain.com

# Local development frontend origin (for CORS during development)
CLIENT_ORIGIN=http://localhost:3000

# ====================================
# AUTHENTICATION & SECURITY
# ====================================

# Cookie name used to store authentication token in browser
AUTH_COOKIE_NAME=authToken

# Authentication cookie maximum age in seconds (86400 seconds = 24 hours)
AUTH_COOKIE_MAX_AGE=86400

# Maximum number of API requests allowed per time window
RATE_LIMIT=100

# Rate limiting time window in milliseconds (60000ms = 1 minute)
RATE_LIMIT_WINDOW=60000

# ====================================
# THIRD-PARTY SERVICES
# ====================================

# Google Maps API key for location services, address validation, and mapping features
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment verification key for validating payment webhooks and transactions
# Used with NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_PAYMENT_VERIFICATION_KEY=your_payment_verification_key_here

# ====================================
# OBSERVABILITY (SigNoz)
# ====================================

# Enable/disable OpenTelemetry instrumentation for monitoring and tracing
# Set to 'true' to send telemetry data to SigNoz
# Server-side (Node.js runtime)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.yourdomain.com
OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=your_signoz_access_token_here

# Client-side (browser) - must use NEXT_PUBLIC_ prefix to be exposed to the browser
NEXT_PUBLIC_OTEL_ENABLED=true
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.yourdomain.com
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=your_signoz_access_token_here